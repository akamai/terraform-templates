## ----------------------------------------------------------------------------
## EdgeGrid
## ----------------------------------------------------------------------------

edgerc_path    = "~/.edgerc"
edgerc_section = "default"

## ----------------------------------------------------------------------------
## domain entries
## ----------------------------------------------------------------------------

domain_validation_entries = [
  {
    domain_name       = "host.domtest.com"
    validation_scope  = "HOST" 
    validation_method = "DNS_TXT"  # Optional: Defaults to "DNS_TXT" if not specified
  },
  {
    domain_name       = "tflab.com"
    validation_scope  = "DOMAIN"
    validation_method = "DNS_TXT"  # Optional: Defaults to "DNS_TXT" if not specified
  },
  {
    domain_name       = "*.tfdom.com"
    validation_scope  = "WILDCARD"
    validation_method = "DNS_TXT"  # Optional: Defaults to "DNS_TXT" if not specified
  }
  
]

## ----------------------------------------------------------------------------
## Enable validation
## ----------------------------------------------------------------------------

enable_validation = false  # Set to true to enable validation

## ----------------------------------------------------------------------------
## Domain search 
## ----------------------------------------------------------------------------

/*

Ex: # Specify domains you want to search or leave blank []

domain_search_entries = [
  {
    domain_name      = "test.example.com"
    validation_scope = "HOST"
  }
]
*/

domain_search_entries = []