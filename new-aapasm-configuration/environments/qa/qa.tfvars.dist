# -------------------------------------------------
# Common Variables
# -------------------------------------------------
edgerc_path    = "~/.edgerc"
edgerc_section = "default"
environment    = "qa"
group_name     = "My Group"
config_name    = "qa-tf-demo-appsec"
description    = "Application security configuration"

# -------------------------------------------------
# Advanced settings
# -------------------------------------------------
inspection_size = 32

# -------------------------------------------------
# Client Lists
#
# You can specify your existent client list IDs by setting create_client_lists=false, use the below powershell command to list client lists
# and adding each ID to the correct parameter.
#
# Get-ClientList -section {edgerc_section} | Select-Object listId
#
# If you need to create all new lists
# set create_client_lists=true. The other input parameters
# will be ignored
# -------------------------------------------------
create_client_lists = true
# IP/Geo Firewall
client_lists_ipblock           = ["215434_MYTFWAFIPBLO"]
client_lists_ipblock_exception = ["214942_MYTFWAFSECURIT"]
client_lists_geoblock          = ["215431_MYTFWAFGEOBL"]
client_lists_asnblock          = ["78901_ASNLIST1", "76543_ASNLIST2"]
# Bypass Lists
client_lists_securitybypass = ["214942_MYTFWAFSECURIT"]
client_lists_rcbypass       = ["214942_MYTFWAFSECURIT"]
client_lists_pragmabypass   = ["214942_MYTFWAFSECURIT"]

# =================================================
# POLICY DEFAULTS
# =================================================
# These values apply to ALL policies unless a policy provides its own override.
#
# HOW TO CHANGE AN ACTION:
#   Valid action values are: "none", "alert", "deny"
#   - "none"  = protection disabled for that rule
#   - "alert" = log only (monitor mode) — good for initial rollout
#   - "deny"  = actively block matching requests
#
#   To change an action, simply update the value here in policy_defaults
#   (affects all policies) or override it in a specific policy entry below.
# =================================================
policy_defaults = {
  # --- Protection Toggles ---
  # Set to true/false to enable/disable entire protection categories.
  enable_waf                 = true
  enable_request_constraints = true
  enable_ip_geo              = true
  enable_malware             = false
  enable_rate                = true
  enable_slow_post           = true
  enable_client_reputation   = true
  enable_botman              = true

  # --- DoS Protection ---
  dos_origin_error_action       = "alert"
  dos_post_page_requests_action = "alert"
  dos_page_view_requests_action = "alert"
  slow_post_action              = "alert"

  # --- WAF Actions ---
  # Controls how each WAF attack group responds when a match is detected.
  # Example: to block SQL injection across all policies, change waf_sql_action to "deny".
  waf_policy_action   = "alert"
  waf_wat_action      = "alert"
  waf_protocol_action = "alert"
  waf_sql_action      = "alert"
  waf_xss_action      = "alert"
  waf_cmd_action      = "alert"
  waf_lfi_action      = "alert"
  waf_rfi_action      = "alert"
  waf_platform_action = "alert"
  penalty_box_action  = "alert"

  # --- Client Reputation Actions ---
  rep_web_attackers_high         = "alert"
  rep_web_attackers_high_shared  = "alert"
  rep_web_attackers_low          = "alert"
  rep_web_attackers_low_shared   = "alert"
  rep_dos_attackers_high         = "alert"
  rep_dos_attackers_high_shared  = "alert"
  rep_dos_attackers_low          = "alert"
  rep_dos_attackers_low_shared   = "alert"
  rep_scanning_tools_high        = "alert"
  rep_scanning_tools_high_shared = "alert"
  rep_scanning_tools_low         = "alert"
  rep_scanning_tools_low_shared  = "alert"
  rep_web_scrapers_high          = "alert"
  rep_web_scrapers_high_shared   = "alert"
  rep_web_scrapers_low           = "alert"
  rep_web_scrapers_low_shared    = "alert"

  # --- Bot Manager General Settings ---
  botman_type               = "bms"
  add_akamai_bot_header     = false
  enable_active_detections  = true
  enable_browser_validation = false
  remove_botman_cookies     = true
  third_party_proxy         = false

  # --- Bot Category Actions ---
  bot_site_monitoring_and_web_development = "monitor"
  bot_academic_or_research                = "monitor"
  bot_job_search_engine                   = "monitor"
  bot_artificial_intelligence_ai          = "monitor"
  bot_online_advertising                  = "monitor"
  bot_ecommerce_search_engine             = "monitor"
  bot_web_search_engine                   = "monitor"
  bot_enterprise_data_aggregator          = "monitor"
  bot_financial_services                  = "monitor"
  bot_social_media_or_blog                = "monitor"
  bot_web_archiver                        = "monitor"
  bot_business_intelligence               = "monitor"
  bot_news_aggregator                     = "monitor"
  bot_rss_feed_reader                     = "monitor"
  bot_financial_account_aggregator        = "monitor"
  bot_media_or_entertainment_search       = "monitor"
  bot_seo_analytics_or_marketing          = "monitor"

  # --- Bot Transparent Detection Actions ---
  bot_impersonators_of_known_bots            = "monitor"
  bot_development_frameworks                 = "monitor"
  bot_http_libraries                         = "monitor"
  bot_web_services_libraries                 = "monitor"
  bot_open_source_crawlersscraping_platforms = "monitor"
  bot_headless_browsersautomation_tools      = "monitor"
  bot_declared_bots_keyword_match            = "monitor"
  bot_aggressive_web_crawlers                = "monitor"
  bot_browser_impersonator                   = "monitor"
  bot_web_scraper_reputation                 = "monitor"

  # --- Bot Active Detection Actions ---
  bot_cookie_integrity_failed                       = "monitor"
  bot_session_validation                            = "monitor"
  bot_client_disabled_javascript_noscript_triggered = "monitor"
  bot_javascript_fingerprint_anomaly                = "monitor"
  bot_javascript_fingerprint_not_received           = "monitor"
}

# =================================================
# POLICIES
# =================================================
# Each entry creates a separate security policy within the configuration.
# Only policy_name, policy_prefix, and hostnames are required.
# Any other field you add overrides the corresponding policy_defaults value
# for that policy ONLY — all omitted fields inherit from policy_defaults.
#
# RULES:
#   - policy_prefix: exactly 4 uppercase alphanumeric characters, unique per policy
#   - hostnames:     must be lowercase, should not overlap between policies
#   - map keys:      stable identifiers — renaming a key destroys/recreates the policy
#
# =================================================
#
# EXAMPLE 1: Single policy (simplest usage, equivalent to v1)
# -----------------------------------------------------------
# policies = {
#   main = {
#     policy_name   = "main-website"
#     policy_prefix = "MN01"
#     hostnames     = ["www.example.com"]
#   }
# }
#
# EXAMPLE 2: Multiple policies with per-policy overrides
# ------------------------------------------------------
# This example creates three policies:
#
#   "main" — The primary website. Inherits all defaults (alert mode).
#
#   "api"  — The API endpoints. Overrides WAF actions to "deny" for SQL
#            injection and XSS to actively block attacks on the API.
#            Disables Bot Manager since API traffic is non-browser.
#
#   "static" — Static assets (images, CSS, JS). Disables Bot Manager,
#              Client Reputation, and Slow POST since these protections
#              are unnecessary for static content.
#
policies = {
  # -------------------------------------------------------
  # Policy: Main Website
  # -------------------------------------------------------
  # No overrides — inherits everything from policy_defaults.
  main = {
    policy_name   = "main-website"
    policy_prefix = "MN01"
    hostnames     = ["qa.example.com"]
  }

  # -------------------------------------------------------
  # Policy: API
  # -------------------------------------------------------
  # Overrides specific WAF actions to "deny" to actively block attacks.
  # Disables Bot Manager (API clients are not browsers).
  #
  # HOW TO EDIT: Add any field from policy_defaults to override it.
  # Only the fields you specify here will differ from the defaults.
  api = {
    policy_name   = "api-policy"
    policy_prefix = "AP01"
    hostnames     = ["qa-api.example.com"]

    # Override WAF actions: block SQL injection and XSS on the API
    waf_sql_action = "deny"
    waf_xss_action = "deny"
    waf_cmd_action = "deny"

    # Override penalty box: deny repeat offenders
    penalty_box_action = "deny"

    # Disable Bot Manager for API traffic
    enable_botman = false
  }

  # -------------------------------------------------------
  # Policy: Static Assets
  # -------------------------------------------------------
  # Minimal protections — static content doesn't need bot detection,
  # client reputation scoring, or slow POST protection.
  static = {
    policy_name   = "static-assets"
    policy_prefix = "ST01"
    hostnames     = ["qa-static.example.com", "qa-cdn.example.com"]

    # Disable protections that are irrelevant for static content
    enable_botman            = false
    enable_client_reputation = false
    enable_slow_post         = false
  }
}
